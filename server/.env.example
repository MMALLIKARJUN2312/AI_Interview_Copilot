# Copy this file to .env and fill in real values. Never commit the real .env file.

# postgresql://<user>:<password>@<host>:5432/<database>
# When running via docker-compose, host should be "db" (the service name).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_copilot

# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI provider fallback chain: comma-separated, tried in order until one
# succeeds (each retries transiently a few times before falling through to
# the next). Built-in providers: "gemini", "groq", "openrouter". Only the
# providers actually listed here need their API key set below.
AI_PROVIDER_CHAIN=gemini, groq

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Free tier at https://console.groq.com - fast inference, generous free quota.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Free-tier models at https://openrouter.ai (look for a ":free" suffix).
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Set to false to disable rate limiting (e.g. in tests) - leave true in production
RATE_LIMIT_ENABLED=true

# Resume storage: "local" (default, single-instance only) or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads/resumes

# Only required when STORAGE_BACKEND=s3. AWS credentials themselves are picked
# up from the standard boto3 credential chain (env vars, IAM role, etc.) -
# never put access keys in this file.
S3_BUCKET_NAME=
AWS_REGION=

# Code execution backend for coding-round questions (DSA / machine coding),
# a Piston-compatible API (https://github.com/engineer-man/piston). Defaults
# to the free public instance - rate-limited, fine for development. Self-host
# Piston and point this at it for production traffic.
CODE_EXECUTION_API_URL=http://localhost:2000/api/v2
CODE_EXECUTION_TIMEOUT_SECONDS=15
