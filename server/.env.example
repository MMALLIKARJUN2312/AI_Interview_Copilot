# Copy this file to .env and fill in real values. Never commit the real .env file.

# postgresql://<user>:<password>@<host>:5432/<database>
# When running via docker-compose, host should be "db" (the service name).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_copilot

# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
