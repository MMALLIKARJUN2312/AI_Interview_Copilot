# Copy this file to .env and fill in real values. Never commit the real .env file.

# postgresql://<user>:<password>@<host>:5432/<database>
# When running via docker-compose, host should be "db" (the service name).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_copilot

# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Set to false to disable rate limiting (e.g. in tests) - leave true in production
RATE_LIMIT_ENABLED=true

# Resume storage: "local" (default, single-instance only) or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads/resumes

# Only required when STORAGE_BACKEND=s3. AWS credentials themselves are picked
# up from the standard boto3 credential chain (env vars, IAM role, etc.) -
# never put access keys in this file.
S3_BUCKET_NAME=
AWS_REGION=
